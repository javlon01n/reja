<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reja</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body style="background-color: #b8bbd1; ">
    <div class="container text-center mt-5">
        <h1 class="mb-4">REJA VA MAQSADLAR</h1>
        
     <div class="card p-3 shadow-sm">
         <form id="create-form" action="/create-item" method="post">
              <div class="row g-2">

                <div class="col-md-9">
                <input style=" font-size: 20px;" id="create-field" 
                name="reja"
                autofocus
                autocomplete="off"
                type="text" 
                class="form-control" >
                </div>
                  
                <div class="col-md-3"> 
                <button style=" font-size: 20px; border-radius: 20px;" class="btn btn-primary w-100">
                    Yangi Reja Qushish
                </button>
              </div>
         </form>
      </div>
    </div>

    <ul id="item-list" style=" background: #ababab; margin-top: 20px; font-size: 20px;"      class="list-group">
      <%items.map(function(item) { %>

         <li class="list-group-item d-flex justify-content-between align-items-center">
        
        <!-- TEXT -->
        <span style="font-size: 20px;"><%=item.reja%></span>

        <!-- BUTTONS -->
        <div>
          <!-- EDIT -->
          <button
          data-id="<%=item._id%>"
          style=" font-size: 20px;" class="btn btn-warning btn-sm me-2">
            Ozgartirish
          </button>

          <!-- DELETE -->
          <form action="/delete-item" method="POST" style="display:inline;">
            <input type="hidden" name="id">
            <button 
            data-id="<%=item._id%>"
            style=" font-size: 20px;" class="btn btn-danger btn-sm">Ochirish</button>
          </form>
        </div>

      </li>

     <% }) %>
    </ul>
    <div class="text-start mt-4">
      <button style=" font-size: 20px;" class="btn btn-danger rounded-pill px-4">
        Hammasini Rejalarni ochirish
      </button>
    </div>
   <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html> 