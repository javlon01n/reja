<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
     <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=Jost:ital,wght@0,100..900;1,100..900&family=Libre+Franklin:ital,wght@0,100..900;1,100..900&family=Merriweather+Sans:ital,wght@0,300..800;1,300..800&family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
     <title>Portfolio</title>
</head>

<body>
    <div class="frame">
        <div class="main_frame">
            <div class="left_frame">
                <div class="left_1">
                    <div class="left_1_1">
                        <img src="images/Profile.svg" >
                    </div>
                    <div class="left_1_2"><%=user.name%></div>
                    <div class="left_1_3"><%=user.profession%></div>
                    <div class="left_icons">
                     <a href="" class="link_href">
                        <div class="icon">
                            <i class="fa-brands fa-facebook fa-xl" style="color: #ffb400;"></i>
                            <!-- <img src="icon/Icons-facebook.svg" alt=""> -->
                        </div>
                     </a>
                     <a href="" class="link_href">
                        <div class="icon">
                            <i class="fa-brands fa-square-instagram fa-xl" style="color: #ffb400;"></i>
                            <!-- <img src="icon/Icons-instagram.svg" alt=""> -->
                        </div>
                     </a>
                     <a href="" class="link_href">
                        <div class="icon">
                            <i class="fa-brands fa-square-twitter fa-xl" style="color: #ffb400;"></i>
                            <!-- <img src="icon/Icons-twitter.svg" alt=""> -->
                        </div>
                     </a>
                     <a href="" class="link_href">
                        <div class="icon">
                            <i class="fa-brands fa-linkedin fa-xl" style="color: #ffb400;"></i>
                            <!-- <img src="icon/Icons-linkedin.svg" alt=""> -->
                        </div>
                     </a>
                     <a href="" class="link_href">
                        <div class="icon">
                            <i class="fa-brands fa-youtube fa-xl" style="color: #ffb400;"></i>
                            <!-- <img src="icon/Icons-Youtube.svg" alt=""> -->
                        </div>
                     </a>
                     <a href="" class="link_href">
                        <div class="icon">
                            <i class="fa-brands fa-square-dribbble fa-xl" style="color: #ffb400;"></i>
                            <!-- <img src="icon/Icons-dribbble.svg" alt=""> -->
                        </div>
                     </a>
                    </div>
                </div>
                <div class="marginer"></div>
                <!-- 2-container -->
                <div class="left_2">
                    <div class="information">
                        <div class="age">Age:</div>
                        <div><%=user.age%></div>
                    </div>
                    <div class="information">
                        <div class="age_2">Residence:</div>
                        <div><%=user.residence%></div>
                    </div>
                    <div class="information">
                        <div class="age_3">Freelance:</div>
                        <div style="color: rgb(2, 147, 69);">Available</div>
                    </div>
                    <div class="information">
                        <div class="age_4">Address:</div>
                        <div><%=user.adress%></div>
                </div>
                    <!-- 2-container end -->

            </div>
            <div class="marginer"></div>
                <div class="left_3">
                    <div class="language">
                        <span>Languages</span>
                    </div>
                    <div class="lang_info">
                        <div class="lang">Uzbek</div>
                        <div class="foiz">100%</div>
                    </div>
                     <div class="box_border">
                        <div class="border_1"></div>
                     </div>
                    <div class="lang_info">
                        <div class="lang">Korean</div>
                        <div class="foiz">80%</div>
                    </div>
                     <div class="box_border">
                        <div class="border_2" style="width: 80%"></div>
                     </div>
                    <div class="lang_info">
                        <div class="lang">English</div>
                        <div class="foiz">60%</div>
                    </div>
                     <div class="box_border">
                        <div class="border_3"  style="width: 60%"></div>
                     </div>
                
                </div>
                <div class="marginer"></div>
                <div class="left_4">
                    <div class="language">
                        <span>Skillis</span>
                    </div>
                    <div class="lang_info">
                        <div class="lang">HTML</div>
                        <div class="foiz">90%</div>
                    </div>
                     <div class="box_border">
                        <div class="border_1" style="width: 90%"></div>
                     </div>
                    <div class="lang_info">
                        <div class="lang">CSS</div>
                        <div class="foiz">85%</div>
                    </div>
                     <div class="box_border">
                        <div class="border_2" style="width: 85%"></div>
                     </div>
                    <div class="lang_info">
                        <div class="lang">Js</div>
                        <div class="foiz">80%</div>
                    </div>
                     <div class="box_border">
                        <div class="border_3"  style="width: 80%"></div>
                     </div>
                      <div class="lang_info">
                        <div class="lang">PHP</div>
                        <div class="foiz">75%</div>
                    </div>
                     <div class="box_border">
                        <div class="border_2" style="width: 75%"></div>
                     </div>
                    <div class="lang_info">
                        <div class="lang">WordPress</div>
                        <div class="foiz">85%</div>
                    </div>
                     <div class="box_border">
                        <div class="border_3"  style="width: 85%"></div>
                     </div>
                </div>
                <div class="marginer"></div>
                <div class="left_5">
                     <div class="language">
                        <span>Extra Skills</span>
                    </div>
                    <div class="lang_info">
                        <div class="lang"><i class="fa-solid fa-check-to-slot" style="color: #ffb400;"></i></div>
                        <div class="Skills">Bootstrap, Materialize</div>
                    </div>
                    <div class="lang_info">
                        <div class="lang"><i class="fa-solid fa-check-to-slot" style="color: #ffb400;"></i></div>
                        <div class="Skills">Stylus, Sass, Less</div>
                    </div>
                    <div class="lang_info">
                        <div class="lang"><i class="fa-solid fa-check-to-slot" style="color: #ffb400;"></i></div>
                        <div class="Skills">Gulp, Webpack,Grunt</div>
                    </div>
                      <div class="lang_info">
                        <div class="lang"><i class="fa-solid fa-check-to-slot" style="color: #ffb400;"></i></div>
                        <div class="Skills">GIT Knowledge</div>
                    </div>
                </div>
                <div class="marginer"></div>
        </div>
        <div class="midd_frame">
            <div class="midd_list">
                <div class="midd_top">
                    <div class="top_left">
                        <p>IT Company </p>
                        <span>
                            Lorem ipsum dolor sit amet, consectetur adipiscing <br>
                             elit. Et, volutpat feugiat placerat lobortis. Natoque <br>
                             rutrum semper sed suspendisse nunc lectus.
                        </span>
                        <button>HIRE ME   <i class="fa-solid fa-arrow-right" style="color: rgb(0, 0, 0);"></i> </button>
                    </div>
                    <div class="top_right">
                         <img src="images/Your Image 1.svg" />
                    </div>
                </div>
                <div class="midd_bootom">
                    <div class="info_top">
                        <p>My Services</p>
                        <span>
                            Amet minim mollit non deserunt ullamco est sit aliqua dolor <br>
                             do amet sint. Velit officia consequat duis enim velit mollit. <br>
                                              lorem ipsum
                        </span>
                    </div>
                    <div class="info_bottom">
                        <div class="info_box">
                            <i class="fa-solid solid fa-laptop-code" style="color: #ffb400;"></i>
                            <p>web development</p>
                            <span>Mblog, e-commerce</span>
                        </div>
                        <div class="info_box">
                            <i class="fa-brands solid fa-square-figma" style="color: #ffb400;"></i>
                            <p>UI/UX Design</p>
                            <span>Mobile app, website design</span>
                        </div>
                        <div class="info_box">
                           <i class="fa-solid solid fa-microphone-lines" style="color: #ffb400;"></i>
                            <p>sound design</p>
                            <span>Voice Over, Beat Making</span>
                        </div>
                        <div class="info_box">
                            <i class="fa-solid solid fa-vr-cardboard" style="color: #ffb400;"></i>
                            <p>game design</p>
                            <span>Character Design, Props & Objects</span>
                        </div>
                        <div class="info_box">
                            <i class="fa-solid solid fa-camera-retro" style="color: #ffb400;"></i>
                            <p>photography</p>
                            <span>portrait, product photography</span>
                        </div>
                        <div class="info_box">
                            <p>advertising</p>
                            <span>Lorem ipsum dolor sit amet,<br>
                                 consectetur adipiscing elit. Vitae 
                                </span>
                                <p style=" color: #FFB400; margin-top: 90px; ">ORDER NOW <i class="fa-solid fa-circle-chevron-right" style="color: #ffb400;"></i></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
            <div class="right_frame">
                <i class="fa-solid right fa-toggle-on" style="color: rgb(0, 0, 0);"></i>
                <div class="right_menu"> 
                    <i class="fa-solid ok fa-house" style="color: rgb(0, 0, 0);"></i>
                    <i class="fa-solid fa-file-code" style="color: rgb(0, 0, 0);"></i>
                    <i class="fa-solid fa-user-graduate" style="color: rgb(0, 0, 0);"></i>
                    <i class="fa-solid fa-briefcase" style="color: rgb(0, 0, 0);"></i>
                    <i class="fa-solid fa-circle-stop" style="color: rgb(0, 0, 0);"></i>
                    <i class="fa-solid fa-message" style="color: rgb(0, 0, 0);"></i>
                </div>
            </div>
    </div>   
</body>
</html>